# ---------- Core ----------
NOVA_ENV=development
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
NOVA_SECRET_KEY=change-me-in-production
# SQLite by default. For Supabase/Postgres:
# DATABASE_URL=postgresql+psycopg2://postgres:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///./data/nova.db
NOVA_WORKSPACE_DIR=./data/workspace
NOVA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- AI providers (any one is enough; without one NOVA runs in labelled offline mode) ----------
NOVA_AI_PROVIDER=
# gemini | openai | anthropic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ---------- Auth ----------
NOVA_ACCESS_TOKEN_MINUTES=720
# Optional: verify Supabase-issued JWTs from the dashboard instead of local login
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# ---------- WhatsApp Cloud API ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Comma separated E.164 numbers allowed to control NOVA, e.g. +919876543210
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_APP_SECRET=

# ---------- Google (Gmail + Calendar + YouTube) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# ---------- Meta / Instagram ----------
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/integrations/instagram/callback

# ---------- Media / video ----------
FFMPEG_PATH=ffmpeg
PUBLIC_BASE_URL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPENAI_TTS_VOICE=alloy

# ---------- Worker ----------
NOVA_WORKER_ENABLED=true
NOVA_WORKER_CONCURRENCY=2
NOVA_SCHEDULER_ENABLED=true

# ---------- Desktop bridge ----------
DESKTOP_BRIDGE_TOKEN=
DESKTOP_ALLOWED_COMMANDS=git status,npm test,python --version,ls,df -h
